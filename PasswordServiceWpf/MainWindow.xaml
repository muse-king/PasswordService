<Window x:Class="PasswordServiceWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Service"
        Icon="Assets/app.ico"
        Width="960" Height="540" MinWidth="880" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid Margin="16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,14">
            <TextBlock Text="Password Service" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Bottom"/>
            <TextBlock Text="LOCAL SECURITY TOOL" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="Bold" Margin="12,0,0,3" VerticalAlignment="Bottom"/>
        </StackPanel>

        <!-- Main 16:9 Two-Column Content (No Scrollbar) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: 生成与保存 + 密码库位置 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 生成与保存 -->
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="生成与保存" Foreground="{StaticResource BlueBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="名称" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <Border Background="{StaticResource EntryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,10" Padding="8,5">
                            <TextBox x:Name="NameInput" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" FontSize="13"/>
                        </Border>

                        <TextBlock Text="密码" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <Border Background="{StaticResource EntryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,12" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PwdPlainInput" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" FontSize="13" Visibility="Collapsed" TextChanged="PwdPlainInput_TextChanged"/>
                                <PasswordBox x:Name="PwdMaskedInput" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" FontSize="13" PasswordChanged="PwdMaskedInput_PasswordChanged"/>
                                <Button x:Name="TogglePwdBtn" Grid.Column="1" Content="○" Style="{StaticResource InlineIconButton}" Margin="4,0,2,0" Click="TogglePwd_Click" ToolTip="显示/隐藏密码"/>
                                <Button Grid.Column="2" Content="复制" Style="{StaticResource InlineIconButton}" Foreground="{StaticResource BlueBrush}" Click="CopyPwd_Click"/>
                            </Grid>
                        </Border>

                        <!-- 长度 -->
                        <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="长度:" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton x:Name="Len8Radio" Content="8" Foreground="{StaticResource TextBrush}" Margin="0,0,10,0" VerticalAlignment="Center" Checked="LenPreset_Checked"/>
                            <RadioButton x:Name="Len16Radio" Content="16" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,10,0" VerticalAlignment="Center" Checked="LenPreset_Checked"/>
                            <RadioButton x:Name="Len32Radio" Content="32" Foreground="{StaticResource TextBrush}" Margin="0,0,10,0" VerticalAlignment="Center" Checked="LenPreset_Checked"/>
                            <RadioButton x:Name="LenCustomRadio" Content="自定义:" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" Checked="LenCustom_Checked"/>
                            <Border Background="{StaticResource EntryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Width="46" Padding="4,2">
                                <TextBox x:Name="CustomLenInput" Text="20" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" FontSize="12" TextAlignment="Center" GotFocus="CustomLenInput_GotFocus"/>
                            </Border>
                        </WrapPanel>

                        <!-- 字符类型 -->
                        <WrapPanel Margin="0,0,0,14" VerticalAlignment="Center">
                            <TextBlock Text="字符:" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox x:Name="UpperCheck" Content="A-Z" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="LowerCheck" Content="a-z" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="DigitsCheck" Content="0-9" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="SymbolsCheck" Content="符号" IsChecked="True" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="GenerateBtn" Content="随机生成" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Generate_Click"/>
                            <Button x:Name="SaveBtn" Content="保存记录" Style="{StaticResource DarkButton}" Click="Save_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 密码库位置 -->
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="加密密码库" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="VaultPathText" Text="已加密连接 · passwords.enc" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button Content="更改位置" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Margin="0,0,8,0" Click="ChangeLocation_Click"/>
                            <Button Content="打开目录" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Click="OpenFolder_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Column: 密码查询 -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="密码查询" Foreground="{StaticResource BlueBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource EntryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,8,0">
                            <TextBox x:Name="SearchInput" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" FontSize="13" KeyDown="SearchInput_KeyDown"/>
                        </Border>
                        <Button Grid.Column="1" Content="查询" Style="{StaticResource DarkButton}" MinWidth="72" Margin="0,0,8,0" Click="Search_Click"/>
                        <Button Grid.Column="2" Content="显示全部" Style="{StaticResource SecondaryButton}" Padding="10,8" Click="ShowAll_Click"/>
                    </Grid>

                    <!-- 匹配名称列表 -->
                    <ListBox x:Name="MatchList" Grid.Row="2" Background="{StaticResource EntryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource TextBrush}" FontSize="13" SelectionChanged="MatchList_SelectionChanged"/>

                    <!-- 选中结果详情 -->
                    <Border Grid.Row="4" Background="{StaticResource EntryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="112">
                        <StackPanel>
                            <TextBlock x:Name="SearchStatusText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed"/>
                            <TextBlock x:Name="SelectedNameText" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                            <TextBlock x:Name="SelectedPwdText" Foreground="{StaticResource BlueBrush}" FontSize="14" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel x:Name="SelectedActionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                                <Button x:Name="ToggleSelectedBtn" Content="显示" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Margin="0,0,8,0" Click="ToggleSelected_Click"/>
                                <Button Content="复制" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Margin="0,0,8,0" Click="CopySelected_Click"/>
                                <Button x:Name="RenameBtn" Content="改名字" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Margin="0,0,8,0" Click="Rename_Click"/>
                                <Button x:Name="DeleteBtn" Content="删除" Style="{StaticResource DangerButton}" Padding="10,5" FontSize="12" Click="Delete_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Status -->
        <TextBlock x:Name="FooterStatusText" Grid.Row="2" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
    </Grid>
</Window>
