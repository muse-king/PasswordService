<Window x:Class="PasswordServiceWpf.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Service"
        Icon="Assets/app.ico"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="28,26">
        <TextBlock Text="LOCAL SECURITY TOOL" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="Password Service" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" Margin="0,3,0,2"/>
        <TextBlock x:Name="TitleText" Text="输入总密码" Foreground="{StaticResource BlueBrush}" FontSize="14" FontWeight="Bold" Margin="0,16,0,12"/>

        <!-- 首次使用：指定密码库位置 -->
        <StackPanel x:Name="FirstRunPanel" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock Text="请选择加密密码库（passwords.enc）的保存位置；若不指定，将使用本机默认位置。" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="选择文件夹" Style="{StaticResource DarkButton}" Margin="0,0,10,0" Click="ChooseLocation_Click"/>
                <Button Content="使用默认位置" Style="{StaticResource SecondaryButton}" Click="UseDefaultLocation_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- 位置不可用 -->
        <StackPanel x:Name="UnavailablePanel" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock Text="当前配置的密码库不存在或暂时无法访问" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,14"/>
            <Button Content="重新选择位置" Style="{StaticResource DarkButton}" HorizontalAlignment="Left" Click="ChooseLocation_Click"/>
        </StackPanel>

        <!-- 解锁 / 创建密码库 -->
        <Border x:Name="CardPanel" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18">
            <StackPanel>
                <TextBlock Text="总密码" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <Border Background="{StaticResource EntryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,6,0,12" Padding="8,6">
                    <PasswordBox x:Name="PasswordInput" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" FontSize="14" KeyDown="Input_KeyDown"/>
                </Border>

                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                    <TextBlock Text="再次输入总密码" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Border Background="{StaticResource EntryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,6,0,12" Padding="8,6">
                        <PasswordBox x:Name="ConfirmInput" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" FontSize="14" KeyDown="Input_KeyDown"/>
                    </Border>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ActionBtn" Grid.Column="0" Content="解锁" Style="{StaticResource DarkButton}" MinWidth="110" Click="ActionBtn_Click"/>
                    <Button Grid.Column="2" Content="切换位置" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12" Click="ChooseLocation_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
